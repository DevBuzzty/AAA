[Unit]
Description=Arch AI Agent Brain Service
After=network.target ollama.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/arch
ExecStart=/opt/arch/venv/bin/python -m app.api.brain
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/arch

[Install]
WantedBy=multi-user.target
